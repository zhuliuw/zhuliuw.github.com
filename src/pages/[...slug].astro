---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, postHref, readingMinutes, type Post } from '../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPosts();
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const minutes = readingMinutes(post.body);
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <article class="post">
    <p class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span>{minutes} 分钟</span>
      {
        post.data.tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
        ))
      }
    </p>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <nav class="pager" aria-label="相邻文章">
      <span>
        {
          older && (
            <a href={postHref(older)}>
              较早
              <br />
              {older.data.title}
            </a>
          )
        }
      </span>
      <span>
        {
          newer && (
            <a href={postHref(newer)}>
              较新
              <br />
              {newer.data.title}
            </a>
          )
        }
      </span>
    </nav>
  </article>
</Base>
