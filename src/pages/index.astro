---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import Pagination from '../components/Pagination.astro';
import { getPosts, homePageHref, pageSlice } from '../lib/blog';

const posts = await getPosts();
const slice = pageSlice(posts, 1);
---

<Base
  title="zhuliuwu"
  description="zhuliuwu 的个人博客。热爱生活，热爱运动，热爱户外，喜欢探索新事物。"
  next={slice.totalPages > 1 ? homePageHref(2) : undefined}
>
  <section class="masthead">
    <div>
      <p class="eyebrow">生活 · 运动 · 户外</p>
      <h1>热爱生活。</h1>
      <p class="lede">
        热爱运动，热爱户外，喜欢探索新事物，不安于现状。我是 zhuliuwu，把还想记住的东西写在这里。
      </p>
    </div>
    <div class="stamp" aria-hidden="true">2012</div>
  </section>

  <section aria-labelledby="writing-label">
    <div class="section-label">
      <h2 id="writing-label">文章</h2>
      <p>
        {slice.from}–{slice.to} / {slice.total}
        <a href="/archive/">全部归档</a>
      </p>
    </div>
    <EntryList posts={slice.items} />
    <Pagination page={slice.page} totalPages={slice.totalPages} hrefFor={homePageHref} />
  </section>
</Base>
