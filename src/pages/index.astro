---
import Base from '../layouts/Base.astro';
import { formatDateShort, getPosts, postHref } from '../lib/blog';

const posts = await getPosts();
---

<Base title="zhuliuwu" description="zhuliuwu 的个人博客。上海，写 Java。技术只是一个生存的工具。">
  <section class="masthead">
    <p class="eyebrow">上海 · Java · 2012 年起</p>
    <h1>并不热爱技术。</h1>
    <p class="lede">
      技术只是一个生存的工具。我是 zhuliuwu，在上海写 Java。这里留下还用得上的笔记，也留下当时觉得该记一笔的东西。
    </p>
    <div class="stamp" aria-hidden="true">2012</div>
  </section>

  <section aria-labelledby="writing-label">
    <div class="section-label">
      <h2 id="writing-label">文章</h2>
      <a href="/archive/">全部归档</a>
    </div>
    <ol class="entry-list">
      {
        posts.map((post) => (
          <li class="entry">
            <time datetime={post.data.pubDate.toISOString()}>{formatDateShort(post.data.pubDate)}</time>
            <div>
              <h2>
                <a href={postHref(post)}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
            </div>
            <a class="chip" href={`/tags/${encodeURIComponent(post.data.tags[0] ?? post.data.category)}/`}>
              {post.data.tags[0] ?? post.data.category}
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
